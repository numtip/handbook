---
import '../styles/global.css';
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>คลังคู่มือดิจิทัล | สำนักวิจัยและส่งเสริมวิชาการการเกษตร</title>
    <meta name="description" content="ค้นหาแค็ตตาล็อกคู่มือของสำนักวิจัยและส่งเสริมวิชาการการเกษตร มหาวิทยาลัยแม่โจ้" />
  </head>
  <body class="bg-base-100 text-base-content site-shell">
    <header class="site-header header border-b border-white/10 bg-base-100">
      <nav class="container site-nav">
        <a href="#top" class="flex min-w-0 items-center gap-3">
          <span class="brand-mark"><img class="brand-logo" src="/assets/logorae.png" width="64" height="64" alt="ตราสำนักวิจัยและส่งเสริมวิชาการการเกษตร" /></span>
          <span class="site-brand-copy"><strong class="block text-sm sm:text-base">สำนักวิจัยและส่งเสริมวิชาการการเกษตร</strong><span class="text-xs text-base-content/60">คลังคู่มือดิจิทัล</span></span>
        </a>
        <div class="desktop-nav" aria-label="เมนูหลัก"><a href="#top">หน้าหลัก</a><a href="#categories">หมวดหมู่</a><a href="#catalog">ค้นหาคู่มือ</a><a href="#about">เกี่ยวกับ</a></div>
        <details class="mobile-menu"><summary aria-label="เปิดเมนู"><span>เมนู</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></summary><div class="mobile-menu-panel"><a href="#top">หน้าหลัก</a><a href="#categories">หมวดหมู่</a><a href="#catalog">ค้นหาคู่มือ</a><a href="#about">เกี่ยวกับ</a></div></details>
      </nav>
    </header>
    <main id="top">
      <section class="catalog-hero relative overflow-hidden py-14 lg:py-24"><span class="hero-glow hero-glow-one" aria-hidden="true"></span><span class="hero-glow hero-glow-two" aria-hidden="true"></span><span class="hero-grid" aria-hidden="true"></span>
        <div class="container hero-grid-layout grid gap-8 lg:grid-cols-[1.3fr_.7fr] lg:items-end">
          <div class="max-w-2xl"><p class="mb-2 text-sm font-semibold uppercase tracking-[.14em] text-main">Handbook catalog</p><h1>ค้นหาคู่มือที่ใช่<br /><span class="text-main">จากแหล่งข้อมูลเดียว</span></h1><div class="hero-rule"><span></span><em><span id="hero-total">—</span> คู่มือ · 5 หมวดหมู่</em></div><p class="max-w-xl text-lg leading-8">รวบรวมข้อมูลคู่มือของสำนักวิจัยและส่งเสริมวิชาการการเกษตร พร้อมสถานะการเข้าถึงที่ตรวจสอบได้</p></div>
          <div class="hero-stats grid grid-cols-2 gap-3"><div class="rounded-lg bg-white p-5 shadow-sm"><b id="all-count" class="text-3xl text-main">—</b><p class="mt-1 text-sm">รายการในแค็ตตาล็อก</p></div><div class="rounded-lg bg-white p-5 shadow-sm"><b id="verified-count" class="text-3xl text-main">—</b><p class="mt-1 text-sm">รายการที่ตรวจพบ PDF</p></div></div>
        </div>
      </section>
      <section id="categories" class="category-section container mt-10">
        <p class="text-sm font-semibold text-main">เรียกดูตามหน่วยงาน</p>
        <h2>หมวดหมู่เอกสาร</h2>
        <div class="grid gap-4 lg:grid-cols-3">
          <section class="category-admin rounded-xl border border-base-300 bg-base-100 p-5 shadow-sm lg:col-span-1"><h3 class="text-xl">1. กองบริหารงานสำนักวิจัยฯ</h3><div class="mt-4 grid gap-2"><button class="category-button text-left" data-category="admin">1.1 งานบริหารและธุรการ <span data-category-count="admin">— รายการ</span></button><button class="category-button text-left" data-category="finance">1.2 งานคลังและพัสดุ <span data-category-count="finance">— รายการ</span></button><button class="category-button text-left" data-category="policy">1.3 งานนโยบาย แผนและประกันคุณภาพ <span data-category-count="policy">— รายการ</span></button></div></section>
          <button class="category-card text-left" data-category="research"><span class="text-sm font-semibold text-main">2. กองบริหารงานวิจัย</span><strong>เอกสารด้านการวิจัย</strong><span data-category-count="research">— รายการ</span></button>
          <button class="category-card text-left" data-category="extension"><span class="text-sm font-semibold text-main">3. กองบริหารงานบริการวิชาการ</span><strong>เอกสารบริการวิชาการ</strong><span data-category-count="extension">— รายการ</span></button>
        </div>
      </section>      <section id="catalog" class="container section">
        <div class="discovery-panel rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm sm:p-6">
          <div class="filter-heading"><div><p class="text-sm font-semibold text-main">ค้นหาในคลังข้อมูล</p><p class="mt-1 text-sm text-base-content/65">ค้นหาด้วยคำสำคัญ หรือกรองตามหน่วยงาน ปี พ.ศ. และสถานะการเข้าถึง</p></div><button id="clear-filters" class="clear-filters" type="button">ล้างตัวกรอง</button></div>
          <div class="filter-grid mt-5">
            <label class="filter-field filter-search"><span class="filter-label">ค้นหาคู่มือ</span><span class="input input-bordered flex items-center gap-3"><svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg><input id="query" class="grow" type="search" placeholder="ชื่อคู่มือ รหัส หรือคำสำคัญ" /></span></label>
            <label class="filter-field"><span class="filter-label">หน่วยงาน / หมวด</span><select id="division" class="select select-bordered"></select></label>
            <label class="filter-field"><span class="filter-label">ปีที่เผยแพร่ (พ.ศ.)</span><select id="year" class="select select-bordered"></select></label>
            <label class="filter-field"><span class="filter-label">สถานะการเข้าถึง</span><select id="access" class="select select-bordered"><option value="all">ทุกสถานะ</option><option value="public">เปิดดูได้</option><option value="login">ต้องเข้าสู่ระบบ</option><option value="pending">รอยืนยันลิงก์</option><option value="review">ต้องตรวจสอบสิทธิ์</option></select></label>
          </div>
        </div>
        <section id="latest-manuals" class="latest-panel mt-8 hidden" aria-labelledby="latest-title"><div class="latest-panel-heading"><div><p class="text-sm font-semibold text-main">อัปเดตล่าสุด</p><h2 id="latest-title" class="mb-1">คู่มือใหม่ <span id="latest-year"></span></h2><p class="text-base-content/70">รายการปีล่าสุดจะแสดงที่นี่อัตโนมัติเมื่อมีการเพิ่มข้อมูลใหม่</p></div><span class="latest-spark" aria-hidden="true">ใหม่</span></div><div id="latest-cards" class="mt-5 grid gap-4 lg:grid-cols-2"></div></section>        <div class="mt-8"><p class="text-sm font-semibold text-main">ผลการค้นหา</p><h2 class="mb-0">พบ <span id="result-count" aria-live="polite">0</span> รายการ</h2></div>
        <div id="cards" class="mt-6 space-y-10"></div>
        <p id="empty" class="mt-6 hidden rounded-xl border border-dashed border-base-300 p-8 text-center text-base-content/70">ไม่พบคู่มือที่ตรงกับเงื่อนไข</p>
      </section>
      <section id="about" class="bg-dark py-12 text-white"><div class="container flex max-w-5xl gap-4"><div class="grid size-11 shrink-0 place-items-center rounded-lg bg-main">✓</div><div><h2 class="text-2xl">ข้อมูลและการเข้าถึงเอกสาร</h2><p class="max-w-3xl leading-7 text-white/80">เว็บไซต์นี้เผยแพร่เฉพาะข้อมูลเมตา ไม่ได้จัดเก็บไฟล์ PDF ไว้ในเว็บไซต์ และแสดงปุ่มเปิดลิงก์จากแหล่งเดิมตามข้อมูลที่มีอยู่</p></div></div></section>
    </main>
    <script>
      type Access = 'public' | 'login' | 'pending' | 'review';
      type Manual = { id:string; title:string; year:string; division:string; keywords:string; url:string; owner:string; status:string; access:Access };
      const $ = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
      const groups = [
        { key:'admin', org:'1. กองบริหารงานสำนักวิจัยฯ', title:'1.1 งานบริหารและธุรการ', division:'กองบริหารงานสำนักวิจัยฯ / งานบริหารและธุรการ' },
        { key:'finance', org:'1. กองบริหารงานสำนักวิจัยฯ', title:'1.2 งานคลังและพัสดุ', division:'กองบริหารงานสำนักวิจัยฯ / งานคลังและพัสดุ' },
        { key:'policy', org:'1. กองบริหารงานสำนักวิจัยฯ', title:'1.3 งานนโยบาย แผนและประกันคุณภาพ', division:'กองบริหารงานสำนักวิจัยฯ / งานนโยบาย แผนและประกันคุณภาพ' },
        { key:'research', org:'2. กองบริหารงานวิจัย', title:'2. กองบริหารงานวิจัย', division:'กองบริหารงานวิจัย' },
        { key:'extension', org:'3. กองบริหารงานบริการวิชาการ', title:'3. กองบริหารงานบริการวิชาการ', division:'กองบริหารงานบริการวิชาการ' },
      ];
      const label:Record<Access,string> = { public:'เปิดดูได้', login:'ต้องเข้าสู่ระบบ', pending:'รอยืนยันลิงก์', review:'ต้องตรวจสอบสิทธิ์' };
      const badge:Record<Access,string> = { public:'badge-success', login:'badge-warning', pending:'badge-error', review:'badge-neutral' };
      function rows(text:string) { const out:string[][]=[]; let row:string[]=[],cell='',quoted=false; for(let i=0;i<text.length;i+=1){const c=text[i];if(c==='"'&&quoted&&text[i+1]==='"'){cell+=c;i+=1}else if(c==='"')quoted=!quoted;else if(c===','&&!quoted){row.push(cell);cell=''}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&text[i+1]==='\n')i+=1;row.push(cell);if(row.some(Boolean))out.push(row);row=[];cell=''}else cell+=c}row.push(cell);if(row.some(Boolean))out.push(row);return out }
      function parse(text:string):Manual[] { const [head,...data]=rows(text);const at=(name:string)=>head.indexOf(name);const f={id:at('รหัส'),title:at('ชื่อคู่มือ'),year:at('ปี'),division:at('กอง/หมวด'),keywords:at('คำสำคัญ'),url:at('ลิงก์ PDF'),owner:at('เจ้าของ'),status:at('สถานะ')};return data.map((row)=>{const status=row[f.status]||'';const access:Access=status.includes('PDF ตรวจพบ')?'public':status.includes('ต้องล็อกอิน')?'login':status.includes('ต้องยืนยัน')||status.includes('ซ้ำกับรายการอื่น')?'pending':'review';return {id:row[f.id]||'',title:row[f.title]||'',year:row[f.year]||'',division:row[f.division]||'',keywords:row[f.keywords]||'',url:row[f.url]||'',owner:row[f.owner]||'',status,access}}) }
      const option=(value:string,text=value)=>`<option value="${value}">${text}</option>`;
      const card=(m:Manual)=>`<article class="manual-card rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm"><div class="flex items-start justify-between gap-4"><b class="text-xs tracking-[.12em] text-main">${m.id}</b><span class="badge ${badge[m.access]}">${label[m.access]}</span></div><h4 class="mt-3 text-xl leading-7">${m.title}</h4><div class="mt-4 flex flex-wrap gap-2"><span class="badge badge-ghost">${m.year?`พ.ศ. ${m.year}`:'ไม่ระบุปี'}</span>${m.keywords.split(',').slice(0,2).map((word)=>`<span class="badge badge-outline">${word}</span>`).join('')}</div>${m.url?`<a class="btn btn-sm mt-5 bg-main border-main text-white hover:bg-green-700" href="${m.url}" target="_blank" rel="noreferrer">เปิด PDF จากแหล่งเดิม</a>`:`<span class="btn btn-sm mt-5 cursor-not-allowed border-base-300 bg-base-300 text-base-content/60" aria-disabled="true">ยังไม่มีลิงก์ PDF</span>`}<details class="mt-5 border-t border-base-200 pt-4"><summary class="cursor-pointer font-semibold text-main">ดูรายละเอียด</summary><div class="mt-4 rounded-lg bg-base-200 p-4 text-sm leading-6"><p><b>หน่วยงานที่รับผิดชอบ:</b> ${m.owner}</p><p class="mt-2"><b>สถานะจากแหล่งเดิม:</b> ${m.status}</p></div></details></article>`;
      fetch('/data/manuals.csv').then((r)=>r.text()).then((text)=>{const manuals=parse(text);$('all-count').textContent=String(manuals.length);$('hero-total').textContent=String(manuals.length);groups.forEach((group)=>{const count=manuals.filter((manual)=>manual.division===group.division).length;document.querySelectorAll<HTMLElement>(`[data-category-count="${group.key}"]`).forEach((element)=>{element.textContent=`${count} รายการ`})});$('verified-count').textContent=String(manuals.filter((m)=>m.access==='public').length);$('division').innerHTML=option('all','ทั้งหมด')+groups.map((g)=>option(g.key,g.title)).join('');const years=[...new Set(manuals.map((m)=>m.year||'ไม่ระบุปี'))].sort((a,b)=>Number(b)-Number(a));$('year').innerHTML=option('all','ทุกปี (พ.ศ.)')+years.map((year)=>option(year,year==='ไม่ระบุปี'?year:`พ.ศ. ${year}`)).join('');const latestYear=Math.max(...manuals.map((m)=>Number(m.year)).filter(Number.isFinite));const latest=manuals.filter((m)=>Number(m.year)===latestYear);$('latest-year').textContent=`พ.ศ. ${latestYear}`;$('latest-cards').innerHTML=latest.map(card).join('');$('latest-manuals').classList.toggle('hidden',latest.length===0);const syncCategoryButtons=()=>{const selected=$<HTMLSelectElement>('division').value;document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((button)=>{const active=button.dataset.category===selected;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active))})};const render=()=>{syncCategoryButtons();const needle=$<HTMLInputElement>('query').value.toLocaleLowerCase('th-TH');const selected=$<HTMLSelectElement>('division').value;const year=$<HTMLSelectElement>('year').value;const access=$<HTMLSelectElement>('access').value;const found=manuals.filter((m)=>{const key=groups.find((g)=>g.division===m.division)?.key;return(!needle||[m.id,m.title,m.keywords,m.owner].join(' ').toLocaleLowerCase('th-TH').includes(needle))&&(selected==='all'||key===selected)&&(year==='all'||(m.year||'ไม่ระบุปี')===year)&&(access==='all'||m.access===access)});$('result-count').textContent=String(found.length);$('empty').classList.toggle('hidden',found.length!==0);$('cards').innerHTML=groups.map((g)=>{const docs=found.filter((m)=>m.division===g.division);return docs.length?`<section class="mb-10"><p class="font-semibold text-main">${g.org}</p><h3 class="mb-4 text-2xl">${g.title}</h3><div class="grid gap-4 lg:grid-cols-2">${docs.map(card).join('')}</div></section>`:''}).join('')};$('query').addEventListener('input',render);['division','year','access'].forEach((id)=>$(id).addEventListener('change',render));$('clear-filters').addEventListener('click',()=>{$<HTMLInputElement>('query').value='';$<HTMLSelectElement>('division').value='all';$<HTMLSelectElement>('year').value='all';$<HTMLSelectElement>('access').value='all';render();$<HTMLInputElement>('query').focus()});document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((button)=>button.addEventListener('click',()=>{$<HTMLSelectElement>('division').value=button.dataset.category||'all';render();$('catalog').scrollIntoView({behavior:'smooth'})}));render()});
    </script>
  </body>
</html>

---
import '../styles/global.css';
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>คลังคู่มือดิจิทัล | สำนักวิจัยและส่งเสริมวิชาการการเกษตร</title>
    <meta name="description" content="ค้นหาแค็ตตาล็อกคู่มือของสำนักวิจัยและส่งเสริมวิชาการการเกษตร มหาวิทยาลัยแม่โจ้" />
  </head>
  <body class="bg-base-100 text-base-content">
    <header class="header border-b border-base-200 bg-base-100">
      <nav class="container grid grid-cols-[1fr_auto] items-center py-5">
        <a href="#catalog" class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-lg bg-main text-xl font-bold text-white">ค</span>
          <span><strong class="block text-sm sm:text-base">สำนักวิจัยและส่งเสริมวิชาการการเกษตร</strong><span class="text-xs text-base-content/60">คลังคู่มือดิจิทัล</span></span>
        </a>
        <a href="#about" class="text-sm font-medium hover:text-main">เกี่ยวกับคลังข้อมูล</a>
      </nav>
    </header>
    <main>
      <section class="bg-base-200 py-12 lg:py-20">
        <div class="container grid gap-8 lg:grid-cols-[1.3fr_.7fr] lg:items-end">
          <div class="max-w-2xl"><p class="mb-2 text-sm font-semibold uppercase tracking-[.14em] text-main">Handbook catalog</p><h1>ค้นหาคู่มือที่ใช่<br /><span class="text-main">จากแหล่งข้อมูลเดียว</span></h1><p class="max-w-xl text-lg leading-8">รวบรวมข้อมูลคู่มือของสำนักวิจัยและส่งเสริมวิชาการการเกษตร พร้อมสถานะการเข้าถึงที่ตรวจสอบได้</p></div>
          <div class="grid grid-cols-2 gap-3"><div class="rounded-lg bg-white p-5 shadow-sm"><b id="all-count" class="text-3xl text-main">—</b><p class="mt-1 text-sm">รายการในแค็ตตาล็อก</p></div><div class="rounded-lg bg-white p-5 shadow-sm"><b id="verified-count" class="text-3xl text-main">—</b><p class="mt-1 text-sm">รายการที่ตรวจพบ PDF</p></div></div>
        </div>
      </section>
      <section id="catalog" class="container section">
        <div class="rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm sm:p-6">
          <label class="input input-bordered flex items-center gap-3"><svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current"><circle cx="11" cy="11" r="6"></circle><path d="m16 16 4 4"></path></svg><input id="query" class="grow" type="search" placeholder="ค้นหาด้วยชื่อคู่มือ รหัส หรือคำสำคัญ" /></label>
          <div class="mt-4 grid gap-3 sm:grid-cols-3"><label class="form-control"><span class="mb-1 text-sm font-medium">หน่วยงาน / หมวด</span><select id="division" class="select select-bordered"></select></label><label class="form-control"><span class="mb-1 text-sm font-medium">ปี</span><select id="year" class="select select-bordered"></select></label><label class="form-control"><span class="mb-1 text-sm font-medium">สถานะการเข้าถึง</span><select id="access" class="select select-bordered"><option value="all">ทั้งหมด</option><option value="public">เปิดดูได้</option><option value="login">ต้องเข้าสู่ระบบ</option><option value="pending">รอยืนยันลิงก์</option><option value="review">ต้องตรวจสอบสิทธิ์</option></select></label></div>
        </div>
        <div class="mt-8"><p class="text-sm font-semibold text-main">ผลการค้นหา</p><h2 class="mb-0">พบ <span id="result-count">0</span> รายการ</h2></div>
        <div id="cards" class="mt-6 grid gap-4 lg:grid-cols-2"></div>
        <p id="empty" class="mt-6 hidden rounded-xl border border-dashed border-base-300 p-8 text-center text-base-content/70">ไม่พบคู่มือที่ตรงกับเงื่อนไข</p>
      </section>
      <section id="about" class="bg-dark py-12 text-white"><div class="container flex max-w-5xl gap-4"><div class="grid size-11 shrink-0 place-items-center rounded-lg bg-main">✓</div><div><h2 class="text-2xl">ข้อมูลและการเข้าถึงเอกสาร</h2><p class="max-w-3xl leading-7 text-white/80">เว็บไซต์นี้เผยแพร่เฉพาะข้อมูลเมตา ไม่ได้จัดเก็บไฟล์ PDF ไว้ในเว็บไซต์ และเปิดลิงก์เฉพาะรายการที่ตรวจพบไฟล์จากแหล่งเดิม</p></div></div></section>
    </main>
    <script>
      type Access = 'public' | 'login' | 'pending' | 'review';
      type Manual = { id:string; title:string; year:string; division:string; keywords:string; url:string; owner:string; status:string; access:Access };
      const $ = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
      const label:Record<Access,string> = { public:'เปิดดูได้', login:'ต้องเข้าสู่ระบบ', pending:'รอยืนยันลิงก์', review:'ต้องตรวจสอบสิทธิ์' };
      const badge:Record<Access,string> = { public:'badge-success', login:'badge-warning', pending:'badge-error', review:'badge-neutral' };
      function rows(text:string) { const out:string[][]=[]; let row:string[]=[], cell='', quoted=false; for(let i=0;i<text.length;i+=1){const c=text[i]; if(c==='"'&&quoted&&text[i+1]==='"'){cell+=c;i+=1}else if(c==='"')quoted=!quoted;else if(c===','&&!quoted){row.push(cell);cell=''}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&text[i+1]==='\n')i+=1;row.push(cell);if(row.some(Boolean))out.push(row);row=[];cell=''}else cell+=c}row.push(cell);if(row.some(Boolean))out.push(row);return out }
      function parse(text:string):Manual[] { const [head,...data]=rows(text); const at=(name:string)=>head.indexOf(name); const f={id:at('รหัส'),title:at('ชื่อคู่มือ'),year:at('ปี'),division:at('กอง/หมวด'),keywords:at('คำสำคัญ'),url:at('ลิงก์ PDF'),owner:at('เจ้าของ'),status:at('สถานะ')}; return data.map((row)=>{const status=row[f.status]||'';const access:Access=status.includes('PDF ตรวจพบ')?'public':status.includes('ต้องล็อกอิน')?'login':status.includes('ต้องยืนยัน')||status.includes('ซ้ำกับรายการอื่น')?'pending':'review';return {id:row[f.id]||'',title:row[f.title]||'',year:row[f.year]||'',division:row[f.division]||'',keywords:row[f.keywords]||'',url:row[f.url]||'',owner:row[f.owner]||'',status,access}}) }
      const option=(value:string,text=value)=>`<option value="${value}">${text}</option>`;
      fetch('/data/manuals.csv').then((r)=>r.text()).then((text)=>{const manuals=parse(text); $('all-count').textContent=String(manuals.length); $('verified-count').textContent=String(manuals.filter((m)=>m.access==='public').length); $('division').innerHTML=option('all','ทั้งหมด')+[...new Set(manuals.map((m)=>m.division))].map(option).join(''); $('year').innerHTML=option('all','ทั้งหมด')+[...new Set(manuals.map((m)=>m.year||'ไม่ระบุปี'))].map(option).join(''); const render=()=>{const needle=$<HTMLInputElement>('query').value.toLocaleLowerCase('th-TH');const division=$<HTMLSelectElement>('division').value;const year=$<HTMLSelectElement>('year').value;const access=$<HTMLSelectElement>('access').value;const found=manuals.filter((m)=>(!needle||[m.id,m.title,m.keywords,m.owner].join(' ').toLocaleLowerCase('th-TH').includes(needle))&&(division==='all'||m.division===division)&&(year==='all'||(m.year||'ไม่ระบุปี')===year)&&(access==='all'||m.access===access));$('result-count').textContent=String(found.length);$('empty').classList.toggle('hidden',found.length!==0);$('cards').innerHTML=found.map((m)=>`<article class="rounded-xl border border-base-300 bg-base-100 p-5 shadow-sm"><div class="flex items-start justify-between gap-4"><b class="text-xs tracking-[.12em] text-main">${m.id}</b><span class="badge ${badge[m.access]}">${label[m.access]}</span></div><h3 class="mt-3 text-xl leading-7">${m.title}</h3><p class="text-sm text-base-content/70">${m.division}</p><div class="mt-4 flex flex-wrap gap-2"><span class="badge badge-ghost">ปี ${m.year||'ไม่ระบุ'}</span>${m.keywords.split(',').slice(0,2).map((word)=>`<span class="badge badge-outline">${word}</span>`).join('')}</div><details class="mt-5 border-t border-base-200 pt-4"><summary class="cursor-pointer font-semibold text-main">ดูรายละเอียด</summary><div class="mt-4 rounded-lg bg-base-200 p-4 text-sm leading-6"><p><b>หน่วยงานที่รับผิดชอบ:</b> ${m.owner}</p><p class="mt-2"><b>สถานะจากแหล่งเดิม:</b> ${m.status}</p>${m.access==='public'&&m.url?`<a class="btn btn-sm mt-4 bg-main border-main text-white hover:bg-green-700" href="${m.url}" target="_blank" rel="noreferrer">เปิด PDF จากแหล่งเดิม</a>`:''}</div></details></article>`).join('')};['query','division','year','access'].forEach((id)=>$(id).addEventListener('input',render));render()});
    </script>
  </body>
</html>

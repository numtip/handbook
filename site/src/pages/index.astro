---
import '../styles/global.css';
---

<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Handbook Catalog สำนักวิจัยและส่งเสริมวิชาการการเกษตร มหาวิทยาลัยแม่โจ้" />
    <title>Handbook Catalog | สำนักวิจัยฯ</title>
    <script is:inline>
      if (localStorage.getItem('handbook-theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 transition-colors duration-300 dark:bg-neutral-900 dark:text-neutral-50">
    <header class="border-b border-forest-100 bg-white/90 backdrop-blur dark:border-neutral-500/30 dark:bg-neutral-900/90">
      <nav class="catalog-shell flex min-h-20 items-center justify-between gap-4">
        <a href="#catalog" class="flex min-w-0 items-center gap-3">
          <img src="/assets/logorae.png" width="56" height="56" alt="ตราสำนักวิจัยและส่งเสริมวิชาการการเกษตร" class="h-12 w-12 rounded-xl2 border border-forest-100 bg-white object-contain p-1 shadow-sm" />
          <span class="min-w-0"><strong class="block truncate text-sm text-forest-700 dark:text-forest-100 sm:text-base">สำนักวิจัยและส่งเสริมวิชาการการเกษตร</strong><span class="text-xs text-neutral-500 dark:text-neutral-50/60">Handbook Catalog</span></span>
        </a>
        <div class="nav-actions">
          <div class="desktop-nav" aria-label="เมนูหลัก"><a href="#catalog">ค้นหาคู่มือ</a><button id="desktop-filter-button" type="button">กรองคู่มือ</button></div>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="สลับโหมดสี" title="สลับโหมดสี"><span aria-hidden="true">◐</span><span class="theme-label">โหมดสี</span></button>
          <button id="mobile-menu-toggle" class="mobile-menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="เปิดเมนู"><span aria-hidden="true">☰</span><span>เมนู</span></button>
        </div>
      </nav>
      <div id="mobile-menu" class="mobile-menu hidden" aria-hidden="true">
        <div class="catalog-shell mobile-menu-panel">
          <a href="#catalog" data-close-menu>หน้าหลัก</a>
          <button id="mobile-menu-filter" type="button">☷ กรองคู่มือ</button>
          <button id="mobile-menu-theme" type="button">◐ สลับโหมดสี</button>
        </div>
      </div>
    </header>

    <main id="catalog">
      <!-- Hero and data-driven statistics -->
      <section class="hero-surface">
        <div class="catalog-shell py-12 sm:py-16">
          <p class="eyebrow">คลังคู่มือดิจิทัล</p>
          <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight text-white sm:text-5xl">ค้นหาคู่มือวิจัยและเกษตร<br /><span class="text-gold-500">จากแหล่งข้อมูลเดียว</span></h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-white/80 sm:text-lg">ค้นหา กรอง และเปิดอ่านคู่มือจากสำนักวิจัยและส่งเสริมวิชาการการเกษตรได้อย่างรวดเร็ว</p>
          <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
            <div class="stat-card"><b id="stat-total">—</b><span>คู่มือทั้งหมด</span></div>
            <div class="stat-card"><b id="stat-divisions">—</b><span>หมวดหมู่</span></div>
            <div class="stat-card"><b id="stat-latest">—</b><span>ปีล่าสุด</span></div>
            <div class="stat-card"><b id="stat-range" class="text-xl sm:text-2xl">—</b><span>ช่วงปีเผยแพร่</span></div>
          </div>
        </div>
      </section>

      <section class="catalog-shell py-8 sm:py-12">
        <!-- Search and sort -->
        <div class="search-panel">
          <label class="search-input"><span aria-hidden="true">⌕</span><input id="query" type="search" placeholder="ค้นหาด้วยชื่อคู่มือ รหัส คำสำคัญ หรือเจ้าของ" autocomplete="off" /></label>
          <label class="sort-control"><span>เรียงตาม</span><select id="sort"><option value="newest">ปีใหม่สุด</option><option value="oldest">ปีเก่าสุด</option><option value="title">ชื่อ ก-ฮ</option></select></label>
          <button id="mobile-inline-filter-button" class="mobile-filter-trigger" type="button">☷ <span>กรองคู่มือ</span><span id="mobile-filter-count" class="hidden"></span></button>
        </div>

        <!-- Desktop multi-select filter chips -->
        <section id="desktop-filters" class="desktop-filters mt-7" aria-label="ตัวกรองคู่มือ">
          <div class="filter-heading"><h2>กรองคู่มือ</h2><button id="clear-filters" class="clear-button" type="button">ล้างตัวกรองทั้งหมด</button></div>
          <div class="filter-group"><h3>กอง / หมวด</h3><div id="division-chips" class="chip-row"></div></div>
          <div class="filter-group mt-5"><h3>ปี พ.ศ.</h3><div id="year-chips" class="chip-row"></div></div>
        </section>

        <!-- Results -->
        <section class="mt-10" aria-live="polite">
          <div class="flex items-end justify-between gap-4"><div><p class="eyebrow text-forest-500">ผลการค้นหา</p><h2 class="mt-1 text-2xl font-bold sm:text-3xl">พบ <span id="result-count">—</span> รายการ</h2></div><p id="active-filter-note" class="hidden text-sm text-neutral-500 dark:text-neutral-50/60"></p></div>
          <div id="skeletons" class="card-grid mt-6" aria-label="กำลังโหลดข้อมูล"><div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div></div>
          <div id="cards" class="card-grid mt-6 hidden"></div>
          <div id="empty" class="hidden empty-state"><span>🌱</span><h3>ไม่พบคู่มือที่ค้นหา</h3><p>ลองปรับคำค้น หรือเลือกหมวดหมู่และปีอื่น</p><button id="empty-clear" class="primary-button" type="button">ล้างตัวกรองทั้งหมด</button></div>
        </section>
      </section>
    </main>

    <!-- Mobile filter bottom sheet -->
    <div id="filter-sheet" class="filter-sheet hidden" aria-hidden="true"><div class="sheet-backdrop" data-close-sheet></div><section class="sheet-panel" role="dialog" aria-modal="true" aria-labelledby="sheet-title"><div class="drag-handle"></div><div class="flex items-center justify-between gap-4"><h2 id="sheet-title">กรองคู่มือ</h2><button class="clear-button" data-close-sheet type="button">ปิด</button></div><div class="filter-group mt-5"><h3>กอง / หมวด</h3><div id="mobile-division-chips" class="chip-row"></div></div><div class="filter-group mt-5"><h3>ปี พ.ศ.</h3><div id="mobile-year-chips" class="chip-row"></div></div><div class="mt-6 flex gap-3"><button id="sheet-clear" class="secondary-button flex-1" type="button">ล้างทั้งหมด</button><button id="sheet-apply" class="primary-button flex-1" type="button">แสดงผลลัพธ์</button></div></section></div>

    <script>
      type Manual = { id: string; title: string; year: string; division: string; keywords: string; url: string; owner: string };
      type SortMode = 'newest' | 'oldest' | 'title';
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const state = { query: '', divisions: new Set<string>(), years: new Set<string>(), sort: 'newest' as SortMode };
      let manuals: Manual[] = [];

      // CSV parser supports quoted Thai keywords and blank cells.
      function csvRows(text: string) { const output: string[][] = []; let row: string[] = []; let cell = ''; let quoted = false; for (let index = 0; index < text.length; index += 1) { const character = text[index]; if (character === '"' && quoted && text[index + 1] === '"') { cell += character; index += 1; } else if (character === '"') quoted = !quoted; else if (character === ',' && !quoted) { row.push(cell); cell = ''; } else if ((character === '\n' || character === '\r') && !quoted) { if (character === '\r' && text[index + 1] === '\n') index += 1; row.push(cell); if (row.some(Boolean)) output.push(row); row = []; cell = ''; } else cell += character; } row.push(cell); if (row.some(Boolean)) output.push(row); return output; }
      function parseCatalog(text: string): Manual[] { const [header, ...data] = csvRows(text); const at = (name: string) => header.indexOf(name); const fields = { id: at('รหัส'), title: at('ชื่อคู่มือ'), year: at('ปี'), division: at('กอง/หมวด'), keywords: at('คำสำคัญ'), url: at('ลิงก์ PDF'), owner: at('เจ้าของ') }; return data.map((row) => ({ id: row[fields.id] || '', title: row[fields.title] || '', year: row[fields.year] || '', division: row[fields.division] || '', keywords: row[fields.keywords] || '', url: row[fields.url] || '', owner: row[fields.owner] || '' })); }
      function escapeHtml(value: string) { return value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' }[character] || character)); }
      function highlight(value: string) { const safe = escapeHtml(value); const term = state.query.trim(); if (!term) return safe; const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); return safe.replace(new RegExp(`(${escaped})`, 'gi'), '<mark class="bg-gold-100 text-earth-600">$1</mark>'); }
      function categoryLabel(value: string) { return value.split('/').map((part) => part.trim()).pop() || value; }
      function safeUrl(value: string) { return /^https?:\/\//i.test(value) ? value : ''; }
      function card(manual: Manual) { const tags = manual.keywords.split(',').filter(Boolean).slice(0, 3).map((tag) => `<span>${highlight(tag.trim())}</span>`).join(''); const url = safeUrl(manual.url); return `<article class="catalog-card"><div class="card-top"><span class="division-badge">🌾 ${escapeHtml(categoryLabel(manual.division))}</span></div><h3>${highlight(manual.title)}</h3><div class="card-meta"><span>📅 ปี ${escapeHtml(manual.year || 'ไม่ระบุ')}</span><span>•</span><span>รหัส ${escapeHtml(manual.id)}</span></div><div class="tag-row">${tags}</div><div class="card-footer"><span>👤 ${escapeHtml(manual.owner || 'ไม่ระบุเจ้าของ')}</span>${url ? `<a href="${escapeHtml(url)}" target="_blank" rel="noreferrer">เปิดอ่าน PDF <span aria-hidden="true">→</span></a>` : `<span class="unavailable">ไม่มีลิงก์ PDF</span>`}</div></article>`; }
      function chip(kind: 'division' | 'year', value: string, label: string) { const selected = kind === 'division' ? state.divisions.has(value) : state.years.has(value); return `<button class="filter-chip ${selected ? 'chip-active' : ''}" type="button" data-filter-kind="${kind}" data-filter-value="${escapeHtml(value)}" aria-pressed="${selected}">${escapeHtml(label)}${selected ? '<span aria-hidden="true">×</span>' : ''}</button>`; }
      function renderChips() { const divisions = [...new Set(manuals.map((manual) => manual.division).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'th')); const years = [...new Set(manuals.map((manual) => manual.year || 'ไม่ระบุปี'))].sort((a, b) => Number(b) - Number(a)); const divisionMarkup = divisions.map((division) => chip('division', division, categoryLabel(division))).join(''); const yearMarkup = years.map((year) => chip('year', year, year === 'ไม่ระบุปี' ? year : `พ.ศ. ${year}`)).join(''); $('division-chips').innerHTML = divisionMarkup; $('year-chips').innerHTML = yearMarkup; $('mobile-division-chips').innerHTML = divisionMarkup; $('mobile-year-chips').innerHTML = yearMarkup; }
      function resetFilters() { state.query = ''; state.divisions.clear(); state.years.clear(); state.sort = 'newest'; $('query').value = ''; $('sort').value = 'newest'; render(); }
      function render() { renderChips(); const query = state.query.toLocaleLowerCase('th-TH'); const results = manuals.filter((manual) => { const haystack = [manual.id, manual.title, manual.keywords, manual.owner, manual.division].join(' ').toLocaleLowerCase('th-TH'); const year = manual.year || 'ไม่ระบุปี'; return (!query || haystack.includes(query)) && (!state.divisions.size || state.divisions.has(manual.division)) && (!state.years.size || state.years.has(year)); }).sort((a, b) => state.sort === 'title' ? a.title.localeCompare(b.title, 'th') : state.sort === 'oldest' ? Number(a.year || 0) - Number(b.year || 0) : Number(b.year || 0) - Number(a.year || 0)); $('result-count').textContent = String(results.length); $('cards').innerHTML = results.map(card).join(''); $('cards').classList.toggle('hidden', results.length === 0); $('empty').classList.toggle('hidden', results.length !== 0); const selected = state.divisions.size + state.years.size; $('active-filter-note').classList.toggle('hidden', selected === 0); $('active-filter-note').textContent = selected ? `เลือกตัวกรอง ${selected} รายการ` : ''; $('mobile-filter-count').classList.toggle('hidden', selected === 0); $('mobile-filter-count').textContent = selected ? String(selected) : ''; }
      function renderStats() { const years = manuals.map((manual) => Number(manual.year)).filter(Number.isFinite); $('stat-total').textContent = String(manuals.length); $('stat-divisions').textContent = String(new Set(manuals.map((manual) => manual.division).filter(Boolean)).size); $('stat-latest').textContent = years.length ? String(Math.max(...years)) : '—'; $('stat-range').textContent = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : 'ไม่ระบุ'; }
      function setSheet(open: boolean) { $('filter-sheet').classList.toggle('hidden', !open); $('filter-sheet').setAttribute('aria-hidden', String(!open)); }
      function setMenu(open: boolean) { const menu = $('mobile-menu'); menu.classList.toggle('hidden', !open); menu.hidden = !open; menu.setAttribute('aria-hidden', String(!open)); $('mobile-menu-toggle').setAttribute('aria-expanded', String(open)); }
      function toggleTheme() { const dark = document.documentElement.classList.toggle('dark'); localStorage.setItem('handbook-theme', dark ? 'dark' : 'light'); }
      function openFilters() { setMenu(false); if (window.matchMedia('(max-width: 767px)').matches) setSheet(true); else $('desktop-filters').scrollIntoView({ behavior: 'smooth', block: 'start' }); }

      // Events for search, chips, sort, mobile sheet, and dark mode.
      $('query').addEventListener('input', (event) => { state.query = (event.target as HTMLInputElement).value; render(); });
      $('sort').addEventListener('change', (event) => { state.sort = (event.target as HTMLSelectElement).value as SortMode; render(); });
      document.addEventListener('click', (event) => { const target = event.target as HTMLElement; const chipButton = target.closest<HTMLButtonElement>('[data-filter-kind]'); if (chipButton) { const kind = chipButton.dataset.filterKind as 'division' | 'year'; const value = chipButton.dataset.filterValue || ''; const selected = kind === 'division' ? state.divisions : state.years; selected.has(value) ? selected.delete(value) : selected.add(value); render(); } if (target.closest('[data-close-sheet]')) setSheet(false); });
      $('clear-filters').addEventListener('click', resetFilters); $('empty-clear').addEventListener('click', resetFilters); $('sheet-clear').addEventListener('click', resetFilters); $('sheet-apply').addEventListener('click', () => setSheet(false));
      $('desktop-filter-button').addEventListener('click', openFilters); $('mobile-inline-filter-button').addEventListener('click', openFilters); $('mobile-menu-filter').addEventListener('click', openFilters);
      document.addEventListener('click', (event) => { const target = event.target as HTMLElement; if (target.closest('#mobile-menu-toggle')) { setMenu(!$('mobile-menu').classList.contains('hidden')); return; } if (target.closest('[data-close-menu]')) setMenu(false); }); document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { setMenu(false); setSheet(false); } });
      $('theme-toggle').addEventListener('click', toggleTheme); $('mobile-menu-theme').addEventListener('click', toggleTheme);

      fetch('/data/manuals.csv').then((response) => { if (!response.ok) throw new Error('ไม่สามารถโหลดข้อมูลได้'); return response.text(); }).then((text) => { manuals = parseCatalog(text); renderStats(); render(); $('skeletons').classList.add('hidden'); }).catch(() => { $('skeletons').classList.add('hidden'); $('empty').classList.remove('hidden'); $('empty').innerHTML = '<span>🌱</span><h3>ไม่สามารถโหลดข้อมูลคู่มือ</h3><p>กรุณาลองใหม่อีกครั้งในภายหลัง</p>'; });
    </script>
  </body>
</html>
